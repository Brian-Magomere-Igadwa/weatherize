# ----------------------------------------------------------------------
# 1. Rust & Cargo
# ----------------------------------------------------------------------
/target/
**/target/
# Ignore Cargo's backup files
**/*.rs.bk

# ----------------------------------------------------------------------
# 2. macOS Specific (since you are on a Mac)
# ----------------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.Trashes

# ----------------------------------------------------------------------
# 3. Editor & IDE Environments
# ----------------------------------------------------------------------
# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# IntelliJ / RustRover
.idea/
*.iml

# Vim / Emacs
*~
*.swp
*.swo
.env

# ----------------------------------------------------------------------
# Temporary Files
# ----------------------------------------------------------------------
workspace_code.txt

# Ignore local database/Grafana data generated by Docker
/deployment/data/
/deployment/grafana/data/
/monitoring/data/
