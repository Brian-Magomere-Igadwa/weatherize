# =========================
# Weather server
# =========================

# Linux examples:
#   /dev/ttyACM0
#   /dev/ttyUSB0
#
# macOS examples:
#   /dev/cu.usbmodem*
#   /dev/cu.usbserial-*
SERIAL_PORT=/dev/ttyACM0

BAUD_RATE=57600
HOST=127.0.0.1
PORT=8080

# =========================
# Kūchō agent
# =========================

KUCHO_MCP_URL=http://127.0.0.1:8080/mcp
KUCHO_OLLAMA_URL=http://127.0.0.1:11434

KUCHO_CHAT_MODEL=qwen3:4b
KUCHO_COMMENTARY_MODEL=qwen2.5:3b

# Speech is optional.
KUCHO_SPEECH=false

# Required only when KUCHO_SPEECH=true.
KUCHO_KOKO_BINARY=
KUCHO_KOKORO_MODEL=
KUCHO_KOKORO_VOICES=

KUCHO_VOICE_STYLE=bm_lewis
KUCHO_SPEECH_SPEED=0.92

# Usually only needed for setups where ONNX Runtime must be loaded dynamically,
# such as the Intel macOS Kokoros setup.
ORT_DYLIB_PATH=
